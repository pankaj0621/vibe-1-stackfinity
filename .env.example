# MongoDB Atlas Connection String
# Optional in development; use a separate *_dev database for local seed data.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lawazia_transit

# Server Session Secret for signing JWT authentication cookies
# SESSION_SECRET is preferred; AUTH_SECRET is accepted as a deployment alias.
# Set a random value with at least 32 characters before running in production.
SESSION_SECRET=

# Authorized Secret required to provision rider accounts via /api/auth/provision-rider
RIDER_PROVISION_SECRET=

# Optional admin account bootstrap values. ADMIN_PASSWORD is generated securely by the script when blank.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Local demo accounts and the isolated development seed use this unique password; 16–72 bytes.
DEMO_USER_PASSWORD=

# Application Environment
NODE_ENV=development
PORT=3000
# CARTO basemap key used by the client map; set this in your deployment environment too.
NEXT_PUBLIC_CARTO_API_KEY=

